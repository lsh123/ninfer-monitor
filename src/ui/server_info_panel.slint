component InfoRow inherits HorizontalLayout {
    in property <string> name: "";
    in property <string> value: "";

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 8px;
    cross-axis-alignment: CrossAxisAlignment.start;

    Text {
        text: root.name;
        width: 70px;
        font-size: 11px;
        font-weight: 600;
        color: #9e9e9e;
    }

    Text {
        text: root.value;
        horizontal-stretch: 1;
        font-size: 12px;
        color: #b0b0b0;
        wrap: word-wrap;
    }
}

export component ServerInfoPanel inherits Rectangle {
    in property <string> summary: "No server info yet";
    in property <string> model: "—";
    in property <string> engine: "—";
    in property <string> server: "—";

    background: #252526;
    border-radius: 6px;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        Rectangle {
            height: 32px;
            background: #2d2d2d;
            border-radius: 4px;

            Text {
                x: 8px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 16px;
                text: root.summary;
                font-size: 11px;
                font-weight: 600;
                color: #9e9e9e;
                overflow: TextOverflow.elide;
            }
        }

        flickable := Flickable {
            vertical-stretch: 1;

            rows-layout := VerticalLayout {
                width: parent.width;
                spacing: 2px;

                InfoRow {
                    name: "Model";
                    value: root.model;
                }

                InfoRow {
                    name: "Engine";
                    value: root.engine;
                }

                InfoRow {
                    name: "Server";
                    value: root.server;
                }
            }
        }
    }
}
