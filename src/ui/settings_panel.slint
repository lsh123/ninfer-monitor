import { DarkButton } from "dark_button.slint";
import { Slider } from "std-widgets.slint";

export component SettingsPanel inherits Rectangle {
    in-out property <int> poll-ms: 500;
    in-out property <int> max-requests: 1000;

    callback save();
    callback close();
    callback about();
    callback escape();

    background: #252526;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3c3c3c;

    about-measure := Text {
        text: "About";
        font-size: 12px;
        visible: false;
    }

    click-blocker := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.escape();
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "Settings";
                    font-size: 14px;
                    font-weight: 700;
                    color: #e0e0e0;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                btn-close-x := DarkButton {
                    text: "×";
                    width: 24px;
                    height: 24px;
                    accessible-text: "Close settings";
                    clicked => {
                        root.close();
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                poll-label := Text {
                    text: root.poll-ms >= 1000
                        ? ((root.poll-ms / 1000).round() == root.poll-ms / 1000
                            ? "Poll interval: " + (root.poll-ms / 1000).to-string-unlocalized() + " s"
                            : "Poll interval: " + (root.poll-ms / 1000).to-fixed(1) + " s")
                        : "Poll interval: " + root.poll-ms.to-string-unlocalized() + " ms";
                    font-size: 12px;
                    color: #9e9e9e;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "100 ms";
                        font-size: 11px;
                        color: #616161;
                    }

                    poll-slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 100;
                        maximum: 5000;
                        value: root.poll-ms;
                        changed(value) => {
                            let step = 100;
                            let rounded = Math.round(value / step) * step;
                            root.poll-ms = rounded;
                            self.value = rounded;
                        }
                    }

                    Text {
                        text: "5 s";
                        font-size: 11px;
                        color: #616161;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                max-label := Text {
                    text: "Max requests: " + root.max-requests.to-string-unlocalized();
                    font-size: 12px;
                    color: #9e9e9e;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "10";
                        font-size: 11px;
                        color: #616161;
                    }

                    max-slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 10;
                        maximum: 1000;
                        value: root.max-requests;
                        changed(value) => {
                            let step = 10;
                            let rounded = Math.round(value / step) * step;
                            root.max-requests = rounded;
                            self.value = rounded;
                        }
                    }

                    Text {
                        text: "1000";
                        font-size: 11px;
                        color: #616161;
                    }
                }
            }

            spacer := Rectangle {
                vertical-stretch: 1;
            }

            about-row := HorizontalLayout {
                spacing: 0px;

                about-link := Rectangle {
                    width: about-measure.width;
                    height: about-measure.height + 2px;

                    about-text := Text {
                        x: 0;
                        y: 0;
                        text: "About";
                        font-size: 12px;
                        color: #4fc3f7;
                    }

                    about-underline := Rectangle {
                        x: 0;
                        y: about-measure.height;
                        width: about-measure.width;
                        height: 1px;
                        background: #4fc3f7;
                    }

                    ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.about();
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                btn-ok := DarkButton {
                    text: "OK";
                    min-width: 60px;
                    height: 24px;
                    clicked => {
                        root.save();
                    }
                }

                btn-cancel := DarkButton {
                    text: "Cancel";
                    min-width: 60px;
                    height: 24px;
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }

    focus-timer := Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.stop();
            scope.focus();
        }
    }
}
