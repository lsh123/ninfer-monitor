import { DarkButton } from "dark_button.slint";
import { LineEdit, Slider } from "std-widgets.slint";

export component SettingsPanel inherits Rectangle {
    in-out property <int> log-poll-ms: 500;
    in-out property <int> gpu-poll-ms: 5000;
    in-out property <int> max-requests: 1000;
    in-out property <string> file: "";
    in-out property <string> temp-unit: "F";
    in-out property <bool> update-check-enabled: true;
    in-out property <int> update-check-days: 3;
    in property <bool> nvidia-popup-visible: false;
    in property <string> nvidia-popup-status: "";

    callback save();
    callback close();
    callback about();
    callback escape();
    callback open-file();
    callback nvidia-popup();

    background: #252526;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3c3c3c;
    height: content-layout.preferred-height;

    click-blocker := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    about-measure := Text {
        text: "About";
        font-size: 12px;
        visible: false;
    }

    nvidia-measure := Text {
        text: "Disable NVIDIA popup";
        font-size: 12px;
        visible: false;
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.escape();
            }
        }

        content-layout := VerticalLayout {
            padding: 48px;
            spacing: 12px;

            Text {
                text: "Settings";
                font-size: 18px;
                font-weight: 700;
                color: #e0e0e0;
            }

            Rectangle {
                height: 16px;
            }

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                file-input := LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.file;
                    placeholder-text: "Path to server.requests.jsonl";
                }

                btn-open-file := DarkButton {
                    text: "Open File...";
                    icon: @image-url("icons/open_folder.svg");
                    has-icon: true;
                    width: 110px;
                    height: 24px;
                    clicked => {
                        root.open-file();
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                log-poll-label := Text {
                    text: root.log-poll-ms >= 1000
                        ? ((root.log-poll-ms / 1000).round() == root.log-poll-ms / 1000
                            ? "Log file poll interval: " + (root.log-poll-ms / 1000).to-string-unlocalized() + " s"
                            : "Log file poll interval: " + (root.log-poll-ms / 1000).to-fixed(1) + " s")
                        : "Log file poll interval: " + root.log-poll-ms.to-string-unlocalized() + " ms";
                    font-size: 12px;
                    color: #9e9e9e;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "100 ms";
                        font-size: 11px;
                        color: #616161;
                    }

                    log-poll-slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 100;
                        maximum: 5000;
                        value: root.log-poll-ms;
                        changed(value) => {
                            let step = 100;
                            let rounded = Math.round(value / step) * step;
                            root.log-poll-ms = rounded;
                            self.value = rounded;
                        }
                    }

                    Text {
                        text: "5 s";
                        font-size: 11px;
                        color: #616161;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                gpu-poll-label := Text {
                    text: ((root.gpu-poll-ms / 1000).round() == root.gpu-poll-ms / 1000
                        ? "GPU poll interval: " + (root.gpu-poll-ms / 1000).to-string-unlocalized() + " s"
                        : "GPU poll interval: " + (root.gpu-poll-ms / 1000).to-fixed(1) + " s");
                    font-size: 12px;
                    color: #9e9e9e;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "1 s";
                        font-size: 11px;
                        color: #616161;
                    }

                    gpu-poll-slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 1000;
                        maximum: 10000;
                        value: root.gpu-poll-ms;
                        changed(value) => {
                            let step = 1000;
                            let rounded = Math.round(value / step) * step;
                            root.gpu-poll-ms = rounded;
                            self.value = rounded;
                        }
                    }

                    Text {
                        text: "10 s";
                        font-size: 11px;
                        color: #616161;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                max-label := Text {
                    text: "Max requests: " + root.max-requests.to-string-unlocalized();
                    font-size: 12px;
                    color: #9e9e9e;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "10";
                        font-size: 11px;
                        color: #616161;
                    }

                    max-slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 10;
                        maximum: 1000;
                        value: root.max-requests;
                        changed(value) => {
                            let step = 10;
                            let rounded = Math.round(value / step) * step;
                            root.max-requests = rounded;
                            self.value = rounded;
                        }
                    }

                    Text {
                        text: "1000";
                        font-size: 11px;
                        color: #616161;
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                temp-label := Text {
                    text: "Temperature unit";
                    font-size: 12px;
                    color: #9e9e9e;
                }

                HorizontalLayout {
                    spacing: 8px;

                    temp-f := DarkButton {
                        text: "°F";
                        width: 60px;
                        height: 24px;
                        selected: root.temp-unit == "F";
                        clicked => {
                            root.temp-unit = "F";
                        }
                    }

                    temp-c := DarkButton {
                        text: "°C";
                        width: 60px;
                        height: 24px;
                        selected: root.temp-unit == "C";
                        clicked => {
                            root.temp-unit = "C";
                        }
                    }
                }
            }

            Rectangle {
                height: 16px;
            }

            update-check-group := VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    update-check-box := Rectangle {
                        width: 16px;
                        height: 16px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-radius: 3px;
                        border-color: root.update-check-enabled ? #4fc3f7 : #616161;

                        check-mark := Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 10px;
                            height: 10px;
                            source: @image-url("icons/check.svg");
                            visible: root.update-check-enabled;
                        }

                        update-check-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.update-check-enabled = !root.update-check-enabled;
                            }
                        }
                    }

                    update-check-label := Text {
                        text: "Check for updates";
                        font-size: 12px;
                        color: #9e9e9e;
                    }
                }

                update-interval-label := Text {
                    text: "Check interval: " + root.update-check-days.to-string-unlocalized() + (root.update-check-days == 1 ? " day" : " days");
                    font-size: 12px;
                    color: #9e9e9e;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "1 day";
                        font-size: 11px;
                        color: #616161;
                    }

                    update-days-slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 1;
                        maximum: 14;
                        value: root.update-check-days;
                        enabled: root.update-check-enabled;
                        changed(value) => {
                            let rounded = Math.round(value);
                            root.update-check-days = rounded;
                            self.value = rounded;
                        }
                    }

                    Text {
                        text: "14 days";
                        font-size: 11px;
                        color: #616161;
                    }
                }
            }

            Rectangle {
                height: 16px;
            }

            if root.nvidia-popup-visible: nvidia-group := VerticalLayout {
                spacing: 4px;

                nvidia-row := HorizontalLayout {
                    spacing: 0px;

                    nvidia-link := Rectangle {
                        width: nvidia-measure.width;
                        height: nvidia-measure.height + 2px;

                        nvidia-text := Text {
                            x: 0;
                            y: 0;
                            text: "Disable NVIDIA popup";
                            font-size: 12px;
                            color: #4fc3f7;
                        }

                        nvidia-underline := Rectangle {
                            x: 0;
                            y: nvidia-measure.height;
                            width: nvidia-measure.width;
                            height: 1px;
                            background: #4fc3f7;
                        }

                        nvidia-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.nvidia-popup();
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                nvidia-status-text := Text {
                    text: root.nvidia-popup-status;
                    font-size: 12px;
                    color: #9e9e9e;
                    visible: root.nvidia-popup-status != "";
                    overflow: elide;
                }
            }

            about-row := HorizontalLayout {
                spacing: 0px;

                about-link := Rectangle {
                    width: about-measure.width;
                    height: about-measure.height + 2px;

                    about-text := Text {
                        x: 0;
                        y: 0;
                        text: "About";
                        font-size: 12px;
                        color: #4fc3f7;
                    }

                    about-underline := Rectangle {
                        x: 0;
                        y: about-measure.height;
                        width: about-measure.width;
                        height: 1px;
                        background: #4fc3f7;
                    }

                    ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.about();
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Rectangle {
                height: 16px;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                btn-ok := DarkButton {
                    text: "OK";
                    width: 90px;
                    height: 24px;
                    clicked => {
                        root.save();
                    }
                }

                btn-cancel := DarkButton {
                    text: "Cancel";
                    width: 90px;
                    height: 24px;
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }

    focus-timer := Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.stop();
            scope.focus();
        }
    }
}
