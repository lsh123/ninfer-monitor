import { DarkButton } from "dark_button.slint";

export component ConfirmDeletePanel inherits Rectangle {
    in property <string> config-name: "";

    callback confirm();
    callback cancel();

    background: #252526;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3c3c3c;
    height: content-layout.preferred-height;

    click-blocker := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.cancel();
            }
        }

        content-layout := VerticalLayout {
            padding: 48px;
            spacing: 12px;

            Text {
                text: "Delete configuration";
                font-size: 18px;
                font-weight: 700;
                color: #e0e0e0;
            }

            Rectangle {
                height: 16px;
            }

            question-text := Text {
                text: "Delete the configuration \"" + root.config-name + "\"?";
                font-size: 14px;
                color: #e0e0e0;
                wrap: word-wrap;
            }

            Rectangle {
                height: 16px;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                btn-delete := DarkButton {
                    text: "Delete";
                    width: 90px;
                    height: 24px;
                    clicked => {
                        root.confirm();
                    }
                }

                btn-cancel := DarkButton {
                    text: "Cancel";
                    width: 90px;
                    height: 24px;
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
    }

    focus-timer := Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.stop();
            scope.focus();
        }
    }
}
