import { DarkButton } from "dark_button.slint";

export component AboutPanel inherits Rectangle {
    in property <string> version: "";

    callback close();

    background: #252526;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3c3c3c;

    click-blocker := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.close();
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "About";
                    font-size: 14px;
                    font-weight: 700;
                    color: #e0e0e0;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                btn-close-x := DarkButton {
                    text: "×";
                    width: 24px;
                    height: 24px;
                    accessible-text: "Close about";
                    clicked => {
                        root.close();
                    }
                }
            }

            body := VerticalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                top-spacer := Rectangle {
                    vertical-stretch: 1;
                }

                about-texts := HorizontalLayout {
                    spacing: 0px;

                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: root.version == "" ? "NInferMonitor" : "NInferMonitor v" + root.version;
                            font-size: 13px;
                            color: #e0e0e0;
                        }

                        Text {
                            text: "Copyright (C) 2026 Aleksey Sanin";
                            font-size: 12px;
                            color: #9e9e9e;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                bottom-spacer := Rectangle {
                    vertical-stretch: 1;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                btn-ok := DarkButton {
                    text: "OK";
                    min-width: 60px;
                    height: 24px;
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}
