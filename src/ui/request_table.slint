export struct RequestRow {
    id: string,
    time: string,
    model: string,
    prompt: string,
    compl: string,
    thinking: string,
    ttft: string,
    total: string,
    reason: string,
    status: string,
    color: color,
    expanded: bool,
    detail-sampling: string,
    detail-engine: string,
    detail-speculative: string,
    detail-tool-call: string,
    detail-prefix: string,
    detail-error: string,
}

component TableRow inherits Rectangle {
    in property <RequestRow> item;
    in property <bool> expanded: false;
    callback clicked(id: string);

    property <bool> hovered: false;
    property <float> hover-x: 0;
    property <float> hover-y: 0;

    property <image> icon-chevron-right: @image-url("icons/chevron-right.svg");
    property <image> icon-chevron-down: @image-url("icons/chevron-down.svg");

    function detail-height(error: string) -> length {
        return 16px + (5 + (error != "" ? 1 : 0)) * 16px + (4 + (error != "" ? 1 : 0)) * 4px;
    }

    height: root.expanded ? 32px + root.detail-height(root.item.detail-error) : 32px;
    border-radius: 4px;
    clip: true;
    background: root.expanded ? #2d5a88 : (root.hovered ? #2d2d30 : #232324);

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            height: 32px;
            padding: 8px;
            spacing: 8px;

            Rectangle {
                width: 16px;
                height: 16px;
            }

            Text {
                text: root.item.id;
                width: 40px;
                font-size: 12px;
                color: root.item.color;
            }

            Text {
                text: root.item.time;
                width: 105px;
                font-size: 12px;
                color: root.item.color;
            }

            Text {
                text: root.item.model;
                horizontal-stretch: 1;
                font-size: 12px;
                color: root.item.color;
                overflow: TextOverflow.elide;
            }

            Text {
                text: root.item.prompt;
                width: 60px;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.compl;
                width: 60px;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.thinking;
                width: 65px;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.ttft;
                width: 65px;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.total;
                width: 60px;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.reason;
                width: 150px;
                font-size: 12px;
                color: root.item.color;
                overflow: TextOverflow.elide;
            }

            Text {
                text: root.item.status;
                width: 75px;
                font-size: 12px;
                color: root.item.color;
            }
        }

        if root.expanded:
            detail-area := Rectangle {
                background: #1e1e1e;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    Text {
                        text: "Sampling: " + root.item.detail-sampling;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Engine: " + root.item.detail-engine;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Speculative: " + root.item.detail-speculative;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Tool call: " + root.item.detail-tool-call;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Prefix: " + root.item.detail-prefix;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    if root.item.detail-error != "":
                        Text {
                            text: "Error: " + root.item.detail-error;
                            height: 16px;
                            font-size: 12px;
                            color: #ef5350;
                            overflow: TextOverflow.elide;
                        }
                }
            }
    }

    expand-icon := Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: root.expanded ? root.icon-chevron-down : root.icon-chevron-right;
    }

    if root.hovered && root.item.status == "error":
        row-tooltip := Rectangle {
            x: Math.max(0px, Math.min(root.hover-x * 1px, parent.width - self.width - 4px));
            y: Math.max(0px, root.hover-y * 1px - self.height - 10px);
            background: #3c3c3c;
            border-width: 1px;
            border-color: #555555;
            border-radius: 3px;

            Text {
                x: 6px;
                y: 4px;
                text: root.item.reason;
                font-size: 12px;
                color: #ef5350;
                max-width: 300px;
                overflow: TextOverflow.elide;
            }
        }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        accessible-role: AccessibleRole.button;
        accessible-label: root.expanded
            ? "Collapse request " + root.item.id
            : "Expand request " + root.item.id;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.hovered = true;
                root.hover-x = self.mouse-x / 1px;
                root.hover-y = self.mouse-y / 1px;
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                root.hovered = true;
                root.hover-x = self.mouse-x / 1px;
                root.hover-y = self.mouse-y / 1px;
            } else {
                root.hovered = false;
            }
        }
        clicked => {
            root.clicked(root.item.id);
        }
    }
}

export component RequestTable inherits Rectangle {
    in property <[RequestRow]> rows;
    in property <length> content-height: 0px;
    in-out property <length> scroll-y;
    in-out property <bool> follow: true;
    callback row-clicked(id: string);

    background: #252526;
    border-radius: 6px;

    changed scroll-y => {
        follow = scroll-y <= 1px;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        Rectangle {
            height: 32px;
            background: #2d2d2d;
            border-radius: 4px;

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;

                Text {
                    text: "";
                    width: 16px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                Text {
                    text: "#";
                    width: 40px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                Text {
                    text: "Time";
                    width: 105px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                Text {
                    text: "Model";
                    horizontal-stretch: 1;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                Text {
                    text: "Prompt";
                    width: 60px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                Text {
                    text: "Compl";
                    width: 60px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                Text {
                    text: "Think";
                    width: 65px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                Text {
                    text: "TTFT";
                    width: 65px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                Text {
                    text: "Total";
                    width: 60px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                Text {
                    text: "Reason";
                    width: 150px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                Text {
                    text: "Status";
                    width: 75px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }
            }
        }

        flickable := Flickable {
            vertical-stretch: 1;
            interactive: true;
            viewport-y <=> root.scroll-y;
            viewport-height: root.content-height;

            rows-layout := VerticalLayout {
                width: parent.width;
                spacing: 4px;

                for r in root.rows: row-el := TableRow {
                    item: r;
                    expanded: r.expanded;
                    clicked(id) => {
                        root.row-clicked(id);
                    }
                }
            }
        }
    }
}
