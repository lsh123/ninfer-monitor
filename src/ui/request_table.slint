export struct RequestRow {
    id: string,
    time: string,
    model: string,
    prompt: string,
    compl: string,
    thinking: string,
    ttft: string,
    total: string,
    reason: string,
    status: string,
    color: color,
    expanded: bool,
    detail-sampling: string,
    detail-engine: string,
    detail-speculative: string,
    detail-tool-call: string,
    detail-prefix: string,
    detail-materialization: string,
    detail-error: string,
}

// A draggable vertical divider between two request-table columns (M7).
//
// The divider controls the width of the column to its left (`left-width`).
// Dragging reports the new width through `width-changed` (on every move, for
// live updates) and `drag-ended` (on release, for persistence).
//
// The drag math: the mouse position is tracked relative to the divider, which
// moves as the left column resizes. Referencing the press position
// (`press-rel-x`) instead of the previous move cancels that feedback, so the
// new width equals the current width plus the mouse travel since press.
component ColumnSlider inherits Rectangle {
    in property <float> left-width: 0;
    callback width-changed(new-left: float);
    callback drag-ended();

    property <float> press-rel-x: 0;
    property <bool> dragging: false;

    width: 8px;
    height: 16px;
    background: transparent;

    bar := Rectangle {
        x: (parent.width - 2px) / 2;
        y: 0;
        width: 2px;
        height: parent.height;
        background: root.dragging ? #4fc3f7 : (ta.has-hover ? #5a5a5a : #3c3c3c);
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.col-resize;
        accessible-role: AccessibleRole.slider;
        accessible-label: "Column divider";
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragging = true;
                root.press-rel-x = self.mouse-x / 1px;
            } else if (event.kind == PointerEventKind.move && root.dragging) {
                let new-w = root.left-width + (self.mouse-x / 1px - root.press-rel-x);
                root.width-changed(new-w);
            } else if (event.kind == PointerEventKind.up
                || event.kind == PointerEventKind.cancel) {
                if root.dragging {
                    root.dragging = false;
                    root.drag-ended();
                }
            }
        }
    }
}

component TableRow inherits Rectangle {
    in property <RequestRow> item;
    in property <bool> expanded: false;
    callback clicked(id: string);

    in property <length> col-id: 40px;
    in property <length> col-time: 105px;
    in property <length> col-model: 352px;
    in property <length> col-prompt: 60px;
    in property <length> col-compl: 60px;
    in property <length> col-think: 65px;
    in property <length> col-ttft: 65px;
    in property <length> col-total: 60px;
    in property <length> col-reason: 150px;
    in property <length> col-status: 75px;

    property <bool> hovered: false;
    property <float> hover-x: 0;
    property <float> hover-y: 0;

    property <image> icon-chevron-right: @image-url("icons/chevron-right.svg");
    property <image> icon-chevron-down: @image-url("icons/chevron-down.svg");

    function detail-height(error: string, materialization: string) -> length {
        let n = 5 + (error != "" ? 1 : 0) + (materialization != "" ? 1 : 0);
        return 16px + n * 16px + (n - 1) * 4px;
    }

    height: root.expanded
        ? 32px + root.detail-height(root.item.detail-error, root.item.detail-materialization)
        : 32px;
    border-radius: 4px;
    clip: true;
    background: root.expanded ? #2d5a88 : (root.hovered ? #2d2d30 : #232324);

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            height: 32px;
            padding: 8px;
            spacing: 8px;

            Rectangle {
                width: 16px;
                height: 16px;
            }

            Text {
                text: root.item.id;
                width: root.col-id;
                font-size: 12px;
                color: root.item.color;
            }

            Text {
                text: root.item.time;
                width: root.col-time;
                font-size: 12px;
                color: root.item.color;
            }

            Text {
                text: root.item.model;
                width: root.col-model;
                font-size: 12px;
                color: root.item.color;
                overflow: TextOverflow.elide;
            }

            Text {
                text: root.item.prompt;
                width: root.col-prompt;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.compl;
                width: root.col-compl;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.thinking;
                width: root.col-think;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.ttft;
                width: root.col-ttft;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.total;
                width: root.col-total;
                font-size: 12px;
                color: root.item.color;
                horizontal-alignment: TextHorizontalAlignment.right;
            }

            Text {
                text: root.item.reason;
                width: root.col-reason;
                font-size: 12px;
                color: root.item.color;
                overflow: TextOverflow.elide;
            }

            Text {
                text: root.item.status;
                width: root.col-status;
                font-size: 12px;
                color: root.item.color;
            }
        }

        if root.expanded:
            detail-area := Rectangle {
                background: #1e1e1e;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    Text {
                        text: "Sampling: " + root.item.detail-sampling;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Engine: " + root.item.detail-engine;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Speculative: " + root.item.detail-speculative;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Tool call: " + root.item.detail-tool-call;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    Text {
                        text: "Prefix: " + root.item.detail-prefix;
                        height: 16px;
                        font-size: 12px;
                        color: #b0b0b0;
                        overflow: TextOverflow.elide;
                    }

                    if root.item.detail-materialization != "":
                        Text {
                            text: "KV materialization: " + root.item.detail-materialization;
                            height: 16px;
                            font-size: 12px;
                            color: #b0b0b0;
                            overflow: TextOverflow.elide;
                        }

                    if root.item.detail-error != "":
                        Text {
                            text: "Error: " + root.item.detail-error;
                            height: 16px;
                            font-size: 12px;
                            color: #ef5350;
                            overflow: TextOverflow.elide;
                        }
                }
            }
    }

    expand-icon := Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: root.expanded ? root.icon-chevron-down : root.icon-chevron-right;
    }

    if root.hovered && root.item.status == "error":
        row-tooltip := Rectangle {
            x: Math.max(0px, Math.min(root.hover-x * 1px, parent.width - self.width - 4px));
            y: Math.max(0px, root.hover-y * 1px - self.height - 10px);
            background: #3c3c3c;
            border-width: 1px;
            border-color: #555555;
            border-radius: 3px;

            Text {
                x: 6px;
                y: 4px;
                text: root.item.reason;
                font-size: 12px;
                color: #ef5350;
                max-width: 300px;
                overflow: TextOverflow.elide;
            }
        }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        accessible-role: AccessibleRole.button;
        accessible-label: root.expanded
            ? "Collapse request " + root.item.id
            : "Expand request " + root.item.id;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.hovered = true;
                root.hover-x = self.mouse-x / 1px;
                root.hover-y = self.mouse-y / 1px;
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                root.hovered = true;
                root.hover-x = self.mouse-x / 1px;
                root.hover-y = self.mouse-y / 1px;
            } else {
                root.hovered = false;
            }
        }
        clicked => {
            root.clicked(root.item.id);
        }
    }
}

export component RequestTable inherits Rectangle {
    in property <[RequestRow]> rows;
    in property <length> content-height: 0px;
    in-out property <length> scroll-y;
    in-out property <bool> follow: true;
    callback row-clicked(id: string);

    // The column widths (M7), in the header row's order; the `Model` column
    // is the flex column (main.rs rebalances it to the window width). The
    // header and row layouts must stay aligned: the header replaces the cell
    // gaps with the 8px column dividers, so it uses `spacing: 0` plus the
    // dividers while the rows keep the 8px gaps.
    in property <length> col-id: 40px;
    in property <length> col-time: 105px;
    in property <length> col-model: 352px;
    in property <length> col-prompt: 60px;
    in property <length> col-compl: 60px;
    in property <length> col-think: 65px;
    in property <length> col-ttft: 65px;
    in property <length> col-total: 60px;
    in property <length> col-reason: 150px;
    in property <length> col-status: 75px;
    callback column-changed(slider: int, new-left: float);
    callback column-released(slider: int);

    background: #252526;
    border-radius: 6px;

    changed scroll-y => {
        follow = scroll-y <= 1px;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        Rectangle {
            height: 32px;
            background: #2d2d2d;
            border-radius: 4px;
            clip: true;

            HorizontalLayout {
                padding: 8px;
                spacing: 0;

                Text {
                    text: "";
                    width: 16px;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                Rectangle {
                    width: 8px;
                }

                Text {
                    text: "#";
                    width: root.col-id;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                col-slider-0 := ColumnSlider {
                    left-width: root.col-id / 1px;
                    width-changed(new-left) => {
                        root.column-changed(0, new-left);
                    }
                    drag-ended => {
                        root.column-released(0);
                    }
                }

                Text {
                    text: "Time";
                    width: root.col-time;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                col-slider-1 := ColumnSlider {
                    left-width: root.col-time / 1px;
                    width-changed(new-left) => {
                        root.column-changed(1, new-left);
                    }
                    drag-ended => {
                        root.column-released(1);
                    }
                }

                Text {
                    text: "Model";
                    width: root.col-model;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                col-slider-2 := ColumnSlider {
                    left-width: root.col-model / 1px;
                    width-changed(new-left) => {
                        root.column-changed(2, new-left);
                    }
                    drag-ended => {
                        root.column-released(2);
                    }
                }

                Text {
                    text: "Prompt";
                    width: root.col-prompt;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                col-slider-3 := ColumnSlider {
                    left-width: root.col-prompt / 1px;
                    width-changed(new-left) => {
                        root.column-changed(3, new-left);
                    }
                    drag-ended => {
                        root.column-released(3);
                    }
                }

                Text {
                    text: "Compl";
                    width: root.col-compl;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                col-slider-4 := ColumnSlider {
                    left-width: root.col-compl / 1px;
                    width-changed(new-left) => {
                        root.column-changed(4, new-left);
                    }
                    drag-ended => {
                        root.column-released(4);
                    }
                }

                Text {
                    text: "Think";
                    width: root.col-think;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                col-slider-5 := ColumnSlider {
                    left-width: root.col-think / 1px;
                    width-changed(new-left) => {
                        root.column-changed(5, new-left);
                    }
                    drag-ended => {
                        root.column-released(5);
                    }
                }

                Text {
                    text: "TTFT";
                    width: root.col-ttft;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                col-slider-6 := ColumnSlider {
                    left-width: root.col-ttft / 1px;
                    width-changed(new-left) => {
                        root.column-changed(6, new-left);
                    }
                    drag-ended => {
                        root.column-released(6);
                    }
                }

                Text {
                    text: "Total";
                    width: root.col-total;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }

                col-slider-7 := ColumnSlider {
                    left-width: root.col-total / 1px;
                    width-changed(new-left) => {
                        root.column-changed(7, new-left);
                    }
                    drag-ended => {
                        root.column-released(7);
                    }
                }

                Text {
                    text: "Reason";
                    width: root.col-reason;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }

                col-slider-8 := ColumnSlider {
                    left-width: root.col-reason / 1px;
                    width-changed(new-left) => {
                        root.column-changed(8, new-left);
                    }
                    drag-ended => {
                        root.column-released(8);
                    }
                }

                Text {
                    text: "Status";
                    width: root.col-status;
                    font-size: 11px;
                    font-weight: 600;
                    color: #9e9e9e;
                }
            }
        }

        flickable := Flickable {
            vertical-stretch: 1;
            interactive: true;
            viewport-y <=> root.scroll-y;
            viewport-height: root.content-height;

            rows-layout := VerticalLayout {
                width: parent.width;
                spacing: 4px;

                for r in root.rows: row-el := TableRow {
                    item: r;
                    expanded: r.expanded;
                    col-id: root.col-id;
                    col-time: root.col-time;
                    col-model: root.col-model;
                    col-prompt: root.col-prompt;
                    col-compl: root.col-compl;
                    col-think: root.col-think;
                    col-ttft: root.col-ttft;
                    col-total: root.col-total;
                    col-reason: root.col-reason;
                    col-status: root.col-status;
                    clicked(id) => {
                        root.row-clicked(id);
                    }
                }
            }
        }
    }
}
