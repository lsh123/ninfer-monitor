import { DarkButton } from "dark_button.slint";
import { LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Splitter } from "splitter.slint";

/// One row of the Control-tab configurations list (v0.3 M3). `running` is
/// `false` until M4 wires the process control.
export struct ConfigRow {
    name: string,
    running: bool,
    error: bool,
}

/// The Control tab (v0.3 M3): the configuration list with the Start /
/// Restart / Stop / Add / Delete buttons and the "Edit configuration" panel.
/// The name / command line fields are in-out (owned by main.rs); edits are
/// applied when the user pauses typing (the 500ms debounce) or on a
/// focus change (main.rs commits the pending edit before each action).
/// The configurations list and the edit panel are divided by a draggable
/// splitter: `control-split-frac` is the share of the middle area given to
/// the configurations list (the edit panel takes the rest); the fraction is
/// persisted in the config (main.rs).
export component ControlPanel inherits Rectangle {
    in property <[ConfigRow]> config-rows;
    in property <int> selected-config: -1;
    in property <bool> start-enabled: false;
    in property <bool> restart-enabled: false;
    in property <bool> stop-enabled: false;
    in property <bool> delete-enabled: false;
    in property <string> status: "";
    in property <bool> status-error: false;
    in-out property <string> name: "";
    in-out property <string> command-line: "";
    // Incremented by main.rs after Add to focus the name field (PRD v0.3 M3:
    // Add "selects it, and focuses the edit panel").
    in property <int> focus-name-request: 0;
    // The share of the middle area (between the buttons and the status line)
    // given to the configurations list; the edit panel takes the rest.
    in property <float> control-split-frac: 0.5;
    in-out property <bool> delete-confirm-visible: false;
    in-out property <string> delete-confirm-name: "";

    callback config-selected(index: int);
    callback add-clicked();
    callback start-clicked();
    callback restart-clicked();
    callback stop-clicked();
    callback edit-paused(name: string, command-line: string);
    callback name-focus-changed(has-focus: bool);
    callback control-split-changed(frac: float);
    callback control-split-released(frac: float);

    background: #252526;
    border-radius: 6px;

    // Debounce the edit fields: apply the pending edit 500ms after the last
    // keystroke (PRD v0.3 M3: edits apply when the user pauses typing).
    edit-debounce := Timer {
        interval: 500ms;
        triggered => {
            self.stop();
            root.edit-paused(root.name, root.command-line);
        }
    }

    // Focus the name field when Add requests it. The handler runs after the
    // selection (and thus the field's visibility) has been applied.
    changed focus-name-request => {
        if root.focus-name-request > 0 {
            name-input.focus();
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // The action buttons: [Start] [Restart] [Stop] ... [Add] [Delete].
        HorizontalLayout {
            spacing: 8px;

            btn-start := DarkButton {
                text: "Start";
                icon: @image-url("icons/play.svg");
                has-icon: true;
                height: 24px;
                disabled: !root.start-enabled;
                clicked => {
                    root.start-clicked();
                }
            }

            btn-restart := DarkButton {
                text: "Restart";
                icon: @image-url("icons/restart.svg");
                has-icon: true;
                height: 24px;
                disabled: !root.restart-enabled;
                clicked => {
                    root.restart-clicked();
                }
            }

            btn-stop := DarkButton {
                text: "Stop";
                icon: @image-url("icons/stop.svg");
                has-icon: true;
                height: 24px;
                disabled: !root.stop-enabled;
                clicked => {
                    root.stop-clicked();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            btn-add := DarkButton {
                text: "Add";
                icon: @image-url("icons/add.svg");
                has-icon: true;
                height: 24px;
                clicked => {
                    root.add-clicked();
                }
            }

            btn-delete := DarkButton {
                text: "Delete";
                icon: @image-url("icons/delete.svg");
                has-icon: true;
                height: 24px;
                disabled: !root.delete-enabled;
                clicked => {
                    if root.selected-config >= 0
                        && root.selected-config < root.config-rows.length {
                        root.delete-confirm-name = root.config-rows[root.selected-config].name;
                    }
                    root.delete-confirm-visible = true;
                }
            }
        }

        // The middle area: the configurations list and the edit panel, divided
        // by a draggable splitter. The list height is derived from
        // `control-split-frac`; the edit panel takes the rest.
        control-middle := Rectangle {
            vertical-stretch: 1;

            configs-list := Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.control-split-frac * Math.max(0px, parent.height - 8px);
                background: #1e1e1e;
                border-radius: 4px;
                border-width: 1px;
                border-color: #3c3c3c;

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;

                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: "Configurations";
                            font-size: 14px;
                            font-weight: 600;
                            color: #9e9e9e;
                        }
                    }

                    configs-scroll := ScrollView {
                        vertical-stretch: 1;
                        mouse-drag-pan-enabled: true;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        viewport-height: Math.max(
                            self.height,
                            root.config-rows.length * 28px
                                + Math.max(0, root.config-rows.length - 1) * 4px
                        );

                        flickable-content := Rectangle {
                            width: parent.width;
                            height: parent.viewport-height;

                            rows-layout := VerticalLayout {
                                width: parent.width;
                                spacing: 4px;

                                for row[idx] in root.config-rows: config-row := Rectangle {
                                    height: 28px;
                                    background: row.error
                                        ? (idx == root.selected-config ? #8a3232 : #5a2d2d)
                                        : (idx == root.selected-config ? #2d5a88 : #232324);
                                    border-radius: 4px;

                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        // The state indicator: green while running, red on a
                                        // start/exit failure.
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            visible: row.running || row.error;
                                            background: row.running ? #4caf50 : #e53935;
                                        }

                                        Text {
                                            text: row.name;
                                            font-size: 12px;
                                            color: #e0e0e0;
                                            overflow: TextOverflow.elide;
                                        }
                                    }

                                    row-ta := TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        mouse-cursor: MouseCursor.pointer;
                                        accessible-role: AccessibleRole.button;
                                        accessible-label: "Select configuration " + row.name;
                                        clicked => {
                                            root.config-selected(idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            control-splitter := Splitter {
                x: 0;
                y: configs-list.height;
                width: parent.width;
                height: 8px;
                current-height: configs-list.height / 1px;
                height-changed(h) => {
                    let space = (control-middle.height - 8px) / 1px;
                    if space > 0 {
                        root.control-split-changed(h / space);
                    }
                }
                drag-ended(h) => {
                    let space = (control-middle.height - 8px) / 1px;
                    if space > 0 {
                        root.control-split-released(h / space);
                    }
                }
            }

            // The "Edit configuration" panel (Name + multi-line command line).
            edit-panel := Rectangle {
                x: 0;
                y: configs-list.height + 8px;
                width: parent.width;
                height: Math.max(0px, parent.height - configs-list.height - 8px);
                background: #1e1e1e;
                border-radius: 4px;
                border-width: 1px;
                border-color: #3c3c3c;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: "Edit configuration";
                            font-size: 14px;
                            font-weight: 600;
                            color: #9e9e9e;
                        }
                    }

                    edit-fields := VerticalLayout {
                        visible: root.selected-config >= 0;
                        spacing: 2px;
                        vertical-stretch: 1;

                        name-label := VerticalLayout {
                            padding-top: 2px;
                            padding-bottom: 2px;

                            Text {
                                text: "Name";
                                font-size: 12px;
                                color: #9e9e9e;
                            }
                        }

                        name-input := LineEdit {
                            height: 24px;
                            text <=> root.name;
                            placeholder-text: "Configuration name";
                            changed has-focus => {
                                root.name-focus-changed(name-input.has-focus);
                            }
                            edited(text) => {
                                edit-debounce.stop();
                                edit-debounce.start();
                            }
                        }

                        command-line-label := VerticalLayout {
                            padding-top: 2px;
                            padding-bottom: 2px;

                            Text {
                                text: "Command line options";
                                font-size: 12px;
                                color: #9e9e9e;
                            }
                        }

                        command-line-input := TextEdit {
                            vertical-stretch: 1;
                            wrap: TextWrap.word-wrap;
                            text <=> root.command-line;
                            placeholder-text: "Command line options";
                            edited(text) => {
                                edit-debounce.stop();
                                edit-debounce.start();
                            }
                        }
                    }

                    no-selection := Text {
                        visible: root.selected-config < 0;
                        text: "No configuration selected";
                        font-size: 12px;
                        color: #616161;
                    }
                }
            }
        }

        // The status line (the last operation's result).
        status-text := Text {
            text: root.status;
            font-size: 12px;
            color: root.status-error ? #f44336 : #9e9e9e;
            visible: root.status != "";
        }
    }
}
