export component MetricWidget inherits Rectangle {
    in property <string> title: "Throughput (tok/s)";
    in property <string> left-label: "Prefill";
    in property <string> left-value: "—";
    in property <string> left-unit: "";
    in property <int> left-trend: 0;
    in property <bool> left-up-is-good: true;
    in property <string> right-label: "Decode";
    in property <string> right-value: "—";
    in property <string> right-unit: "";
    in property <int> right-trend: 0;
    in property <bool> right-up-is-good: true;
    in property <bool> show-flat-trend: true;
    in property <length> left-value-font-size: 27px;
    in property <length> right-value-font-size: 27px;
    in property <image> chart-image;

    out property <float> chart-width: chart-rect.width / 1px;
    out property <float> chart-height: chart-rect.height / 1px;

    background: #252526;
    border-radius: 6px;

    VerticalLayout {
        padding: 8px;
        spacing: 0;

        Text {
            text: root.title;
            font-size: 12px;
            font-weight: 600;
            color: #e0e0e0;
            overflow: TextOverflow.clip;
        }

        Rectangle {
            height: 6px;
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            VerticalLayout {
                width: 120px;
                vertical-stretch: 1;
                alignment: center;
                cross-axis-alignment: center;
                spacing: 2px;

                Text {
                    text: root.left-label;
                    font-size: 11px;
                    color: #9e9e9e;
                    overflow: TextOverflow.clip;
                }

                HorizontalLayout {
                    spacing: 4px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.left-value;
                        font-size: root.left-value-font-size;
                        font-weight: 600;
                        color: #e0e0e0;
                        overflow: TextOverflow.elide;
                    }

                    if root.left-unit != "": Text {
                        text: root.left-unit;
                        font-size: 12px;
                        color: #9e9e9e;
                        overflow: TextOverflow.clip;
                    }

                    if root.left-trend != 0 || root.show-flat-trend: Text {
                        text: root.left-trend > 0 ? "▲" : (root.left-trend < 0 ? "▼" : "—");
                        font-size: 12px;
                        color: root.left-trend == 0 ? #616161 : ((root.left-trend > 0) == root.left-up-is-good ? #4caf50 : #ef5350);
                        overflow: TextOverflow.clip;
                        accessible-label: root.left-trend == 0
                            ? "Trending flat"
                            : (root.left-trend > 0 ? "Trending up" : "Trending down")
                                + ((root.left-trend > 0) == root.left-up-is-good ? ", good" : ", bad");
                    }
                }
            }

            chart-rect := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                background: #1e1e1e;
                border-width: 1px;
                border-color: #3c3c3c;
                border-radius: 4px;

                Image {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    source: root.chart-image;
                }
            }

            VerticalLayout {
                width: 120px;
                vertical-stretch: 1;
                alignment: center;
                cross-axis-alignment: center;
                spacing: 2px;

                Text {
                    text: root.right-label;
                    font-size: 11px;
                    color: #9e9e9e;
                    overflow: TextOverflow.clip;
                }

                HorizontalLayout {
                    spacing: 4px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.right-value;
                        font-size: root.right-value-font-size;
                        font-weight: 600;
                        color: #e0e0e0;
                        horizontal-alignment: center;
                        overflow: TextOverflow.elide;
                    }

                    if root.right-unit != "": Text {
                        text: root.right-unit;
                        font-size: 12px;
                        color: #9e9e9e;
                        overflow: TextOverflow.clip;
                    }

                    if root.right-trend != 0 || root.show-flat-trend: Text {
                        text: root.right-trend > 0 ? "▲" : (root.right-trend < 0 ? "▼" : "—");
                        font-size: 12px;
                        color: root.right-trend == 0 ? #616161 : ((root.right-trend > 0) == root.right-up-is-good ? #4caf50 : #ef5350);
                        overflow: TextOverflow.clip;
                        accessible-label: root.right-trend == 0
                            ? "Trending flat"
                            : (root.right-trend > 0 ? "Trending up" : "Trending down")
                                + ((root.right-trend > 0) == root.right-up-is-good ? ", good" : ", bad");
                    }
                }
            }
        }
    }
}
